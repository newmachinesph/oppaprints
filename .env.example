# Copy to .env.local and fill in. Never commit real secrets.
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Public site origin — used for metadataBase (OG/Twitter absolute URLs).
# Safe to expose (NEXT_PUBLIC_). Set to your production domain when deploying.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
R2_BUCKET=oppaprints
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
SESSION_SECRET=generate-a-long-random-hex
